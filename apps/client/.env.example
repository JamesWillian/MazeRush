# Server WebSocket URL the client connects to.
#
# Local dev (matches the default in src/config.ts):
#   VITE_SERVER_URL=ws://localhost:2567
#
# Production (your Cloudflare Tunnel URL — note WSS not WS):
#   VITE_SERVER_URL=wss://your-tunnel.trycloudflare.com
#
# Vercel: set this in Project Settings → Environment Variables.
VITE_SERVER_URL=ws://localhost:2567
