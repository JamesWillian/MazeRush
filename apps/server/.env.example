# Port the server listens on. Cloudflare Tunnel connects to this locally.
PORT=2567

# Interface to bind. Use 127.0.0.1 in production so only the Cloudflare
# Tunnel (also running locally) can reach the server — protects against
# attackers on the same LAN bypassing your Origin check.
# For LAN multiplayer testing, leave 0.0.0.0.
HOST=0.0.0.0

# Comma-separated whitelist of Origin headers that the browser must send on
# the WebSocket upgrade. Anything else is rejected at handshake time.
#
# Production example (replace with your actual Vercel deployment URL):
#   ALLOWED_ORIGINS=https://mazerush.vercel.app,https://mazerush-yourname.vercel.app
#
# Leave empty in dev to allow any origin (Vite at localhost:5173, plus
# whatever you happen to test with).
ALLOWED_ORIGINS=

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
